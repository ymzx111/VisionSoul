# 复制为 backend/.env 后，在本机填入真实 API Key；不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# low 节省图片输入费用；需要辨认小字或细节时可以改为 high。
DEEPSEEK_IMAGE_DETAIL=low
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TIMEOUT_SECONDS=45

# 每轮最多参考最近 6 轮问答，文字上下文也有长度上限。
CHAT_CONTEXT_TURNS=6
CHAT_CONTEXT_CHARS=12000

# 视频最长30秒、50 MiB；每1秒采样并补末帧，最多31次；相同画面只发一次。
# 首次分析将去重后的图片合并为一次请求；输出最多 8 条核心观察和小灵回应。
VIDEO_MAX_SECONDS=30
VIDEO_MAX_BYTES=52428800
VIDEO_MAX_FRAMES=31
VIDEO_DECODE_TIMEOUT_SECONDS=45
VIDEO_MAX_TOKENS=1600

# 本机中文对白识别；模型预先安装后离线运行，不需要新API密钥。
AUDIO_ENABLED=true
AUDIO_TIMEOUT_SECONDS=180
AUDIO_CPU_THREADS=4
# AUDIO_MODEL_DIR 可选；默认 backend/storage/models/faster-whisper-small

# 本机视频解题完成后的 IDE 路径。Python 默认使用 IDLE，可按需改为 PyCharm。
# LOCAL_PYCHARM="C:/Program Files/JetBrains/PyCharm/bin/pycharm64.exe"
# LOCAL_VISUAL_STUDIO="C:/Program Files/Microsoft Visual Studio/Common7/IDE/devenv.exe"
